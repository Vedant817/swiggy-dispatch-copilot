FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go/go.mod ./go/
WORKDIR /src/go
RUN go mod download
COPY go/ ./
COPY configs/ ../configs/
RUN CGO_ENABLED=0 go build -o /bin/worker ./cmd/worker

FROM alpine:3.20
WORKDIR /app
COPY --from=build /bin/worker /app/worker
COPY configs/ /app/configs/
CMD ["/app/worker"]
